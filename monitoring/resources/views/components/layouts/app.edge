{{--
  Top-level app navigation. Add an entry here for every new area of your
  app, and it shows up in the navigation bar with its active state handled.
--}}
@let(nav = [
  { label: 'Dashboard', route: 'dashboard', icon: 'lucide:house' },
  { label: 'Event history', route: 'history.index', icon: 'lucide:history', fn: 'viewAdcHistory' },
  { label: 'Reports', route: 'reports.index', icon: 'lucide:file-text', fn: 'openSavedReport' },
  { label: 'Audit log', route: 'audit.index', icon: 'lucide:scroll-text', fn: 'viewAuditLog' },
  { label: 'Accounts', route: 'accounts.index', icon: 'lucide:users', fn: 'manageAccounts' },
].filter((item) => !item.fn || (typeof can !== 'undefined' && can(item.fn))))
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="en-us"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {{
        pageTitle
          ? `${pageTitle} - Hospital Monitoring System`
          : 'Hospital Monitoring System'
      }}
    </title>
    {{ csrfMeta() }}
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    @include('partials/demo_banner')
    <header class="header header--bar">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @if(typeof actor !== 'undefined')
            <span class="muted" style="font-size: 13px;">{{ auth.user?.fullName ?? auth.user?.email }} · {{ roleName(actor.role) }}</span>
          @end
          @!themeToggle()
          @form({ route: 'session.destroy', method: 'POST' })
            <button type="submit" class="btn btn--secondary btn--sm">
              @svg('lucide:log-out', { width: 15, height: 15 })
              
              
              Log out


            </button>
          @end
        </div>
      </div>
    </header>

    <nav class="subnav">
      <div class="subnav__inner">
        @each(item in nav)
          @navLink({ route: item.route, class: 'subnav__item' })
            @if(item.icon)
              @svg(item.icon, { width: 14, height: 14 })
            @end
            {{ item.label }}
          @end
        @end
      </div>
    </nav>

    <div class="app-main">{{{ await $slots.main() }}}</div>
    @include('partials/flash_alerts')
  </body>
</html>
