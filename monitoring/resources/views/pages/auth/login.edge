@layouts.auth()
  <h1 class="auth__title">Sign in</h1>
  <p class="auth__sub">Use the account given to you by an administrator.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'name@hospital.test',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Password' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Sign in',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'One moment…' : 'Sign in'",
    })
  @end

  @if(demoAccounts.length)
    <section class="auth__demo" aria-labelledby="demo-title">
      <h2 id="demo-title" class="auth__demo-title">Development: demo accounts</h2>
      <div class="auth__demo-buttons">
        @each(account in demoAccounts)
          <button
            type="button"
            class="btn btn--secondary btn--sm"
            data-email="{{ account.email }}"
            data-password="{{ account.password }}"
            onclick="const form = document.querySelector('.auth__form'); form.email.value = this.dataset.email; form.password.value = this.dataset.password; form.password.focus()"
          >
            {{ account.name }}
          </button>
        @end
      </div>
    </section>
  @end
@end
